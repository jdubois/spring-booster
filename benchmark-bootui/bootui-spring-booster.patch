@@ -0,0 +1,75 @@
+package io.github.jdubois.bootui.sample;
+
+import io.github.jdubois.springbooster.ParallelBootstrapBeanFactoryPostProcessor;
+import io.github.jdubois.springbooster.ParallelBootstrapSettings;
+import java.util.ArrayList;
+import java.util.List;
+import org.springframework.context.ApplicationContextInitializer;
+import org.springframework.context.ConfigurableApplicationContext;
+import org.springframework.core.env.Environment;
+import org.springframework.util.StringUtils;
+
+/**
+ * Opt-in activation of Spring Booster's parallel bean instantiation for the BootUI sample app.
+ *
+ * <p>It registers the library's {@link ParallelBootstrapBeanFactoryPostProcessor} only when the
+ * {@code boost} profile is active or {@code sample.parallel-bootstrap=true} is set. Activation is
+ * driven by a property (rather than the {@code boost} profile) in the benchmark so the same jar can
+ * serve both variants while keeping the default {@code dev} profile active (H2 + in-memory cache).
+ */
+public class SampleParallelBootstrapInitializer
+        implements ApplicationContextInitializer<ConfigurableApplicationContext> {
+
+    @Override
+    public void initialize(ConfigurableApplicationContext applicationContext) {
+        Environment environment = applicationContext.getEnvironment();
+        boolean enabled = environment.matchesProfiles("boost")
+                || Boolean.parseBoolean(environment.getProperty("sample.parallel-bootstrap", "false"));
+        if (!enabled) {
+            return;
+        }
+        // Third benchmark variant: also background mutually-independent consumers of a
+        // shared, fully-constructed infrastructure leaf (Flyway + Liquibase over the same
+        // DataSource). Enabling backgroundSharedInfraConsumers is self-contained: the
+        // library automatically keeps factory-method @Bean co-location active (so unrelated
+        // infrastructure such as Spring Security's authenticationEventPublisher stays on the
+        // main thread) and frees only the pure barrier consumers to overlap. No separate
+        // backgroundFactoryMethodBeans setting is required.
+        boolean sharedInfra =
+                Boolean.parseBoolean(environment.getProperty("sample.shared-infra-consumers", "false"));
+        // Fourth benchmark variant: explicitly allow-list specific heavyweight @Bean beans
+        // (e.g. Spring Security's filter chain) so they may background even though the dynamic
+        // auto-configurations keep every other @Bean on the main thread. Each named bean still
+        // has to clear the structural safety checks, so a forced-mainline depends-on target
+        // (such as the Flyway/Liquibase migrators that JPA pins ahead of itself) stays on the
+        // main thread -- the allowlist is a safe, targeted alternative to
+        // backgroundFactoryMethodBeans. Pass a comma-separated list via sample.background-bean-names.
+        List<String> backgroundBeanNames = List.of(
+                StringUtils.commaDelimitedListToStringArray(environment.getProperty("sample.background-bean-names", "")));
+        // Fifth benchmark variant: name a shared infrastructure singleton that is exposed only
+        // as a co-located @Bean (so the structural barrier predicate cannot detect it) as a
+        // completed-leaf barrier, letting its independent consumers overlap. Self-contained: a
+        // non-empty barrier list activates the completed-leaf relaxation on its own.
+        List<String> barrierBeanNames = List.of(
+                StringUtils.commaDelimitedListToStringArray(environment.getProperty("sample.barrier-bean-names", "")));
+        // Sixth benchmark variant: declare mutually-independent heavyweight @Bean beans as
+        // co-background groups so the planner drops their co-location AND the sync edges between
+        // members. Groups are separated by ';', members within a group by ','.
+        List<List<String>> coBackgroundGroups = new ArrayList<>();
+        for (String group : StringUtils.delimitedListToStringArray(
+                environment.getProperty("sample.co-background-groups", ""), ";")) {
+            String[] members = StringUtils.commaDelimitedListToStringArray(group);
+            if (members.length > 0) {
+                coBackgroundGroups.add(List.of(members));
+            }
+        }
+        ParallelBootstrapSettings settings = ParallelBootstrapSettings.builder()
+                .threadNamePrefix("sample-boot-")
+                .backgroundSharedInfraConsumers(sharedInfra)
+                .backgroundBeanNames(backgroundBeanNames)
+                .barrierBeanNames(barrierBeanNames)
+                .coBackgroundGroups(coBackgroundGroups)
+                .build();
+        applicationContext.addBeanFactoryPostProcessor(new ParallelBootstrapBeanFactoryPostProcessor(settings));
+    }
+}
