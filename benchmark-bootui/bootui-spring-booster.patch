@@ -0,0 +1,58 @@
+package io.github.jdubois.bootui.autoconfigure.web;
+
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.actuate.web.exchanges.HttpExchange;
+import org.springframework.boot.actuate.web.exchanges.HttpExchangeRepository;
+
+/**
+ * An {@link HttpExchangeRepository} decorator that notifies subscribers whenever a new
+ * {@link HttpExchange} is {@link #add(HttpExchange) added}. BootUI registers this as the
+ * primary repository when it provides its own {@link org.springframework.boot.actuate.web.exchanges.InMemoryHttpExchangeRepository},
+ * which lets the live {@code /stream} SSE endpoint on {@link HttpExchangesController} push
+ * browser updates on every incoming request instead of relying on client polling.
+ *
+ * <p>Listeners are invoked synchronously on the calling thread. BootUI's own listener
+ * ({@link io.github.jdubois.bootui.autoconfigure.stream.BootUiChangeStream#signal()}) is
+ * non-blocking by design, so this does not add measurable latency to request recording.</p>
+ */
+public final class NotifyingHttpExchangeRepository implements HttpExchangeRepository {
+
+    private static final Logger log = LoggerFactory.getLogger(NotifyingHttpExchangeRepository.class);
+
+    private final HttpExchangeRepository delegate;
+
+    private final CopyOnWriteArrayList<Runnable> listeners = new CopyOnWriteArrayList<>();
+
+    public NotifyingHttpExchangeRepository(HttpExchangeRepository delegate) {
+        this.delegate = delegate;
+    }
+
+    @Override
+    public List<HttpExchange> findAll() {
+        return delegate.findAll();
+    }
+
+    @Override
+    public void add(HttpExchange httpExchange) {
+        delegate.add(httpExchange);
+        for (Runnable listener : listeners) {
+            try {
+                listener.run();
+            } catch (Exception ex) {
+                log.debug("HTTP exchange listener threw an exception", ex);
+            }
+        }
+    }
+
+    /**
+     * Registers a callback that is invoked on the calling thread after each successful {@link #add}.
+     * Exceptions thrown by the callback are caught and logged at DEBUG level so that one failing
+     * listener cannot affect others or disrupt request recording.
+     */
+    public void subscribe(Runnable listener) {
+        listeners.add(listener);
+    }
+}

